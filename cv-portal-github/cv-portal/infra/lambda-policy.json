{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteAndReadOwnSubmissions",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET_NAME/submissions/*"
    },
    {
      "Sid": "NotifyRecruitingTopic",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:REPLACE_REGION:REPLACE_ACCOUNT_ID:cv-submissions"
    }
  ]
}
