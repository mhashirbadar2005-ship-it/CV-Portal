# Copy to .env for local development. Never commit the real .env.

# Branding
COMPANY_NAME=Averon Automation
CAREERS_EMAIL=careers@averon.example

# AWS — locally these come from `aws configure`; on Lambda the role supplies them
AWS_REGION=ap-south-1
S3_BUCKET=averon-cv-submissions-<your-suffix>
S3_PREFIX=submissions
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:cv-submissions

# Rules
MAX_UPLOAD_MB=4
ALLOWED_EXTENSIONS=pdf,doc,docx
PRESIGNED_URL_TTL=3600

# Runtime
ENVIRONMENT=local
ROOT_PATH=
# Set to true to test the UI with no AWS account at all
DRY_RUN=true
